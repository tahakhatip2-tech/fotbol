{
  "buildCommand": "cd frontend && npm install && npm run build && cd .. && npx prisma generate --schema=./backend/prisma/schema.prisma",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/prisma/**",
      "maxDuration": 30
    }
  }
}
